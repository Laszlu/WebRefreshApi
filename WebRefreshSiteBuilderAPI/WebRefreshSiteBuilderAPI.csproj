<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
      <UserSecretsId>731166bc-1430-429d-94ad-7ef06b213d2b</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Anthropic" Version="12.44.0" />
        <PackageReference Include="ExCSS" Version="4.3.2" />
        <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <PackageReference Include="Microsoft.Playwright" Version="1.56.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="OpenAI" Version="2.13.0" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
      <None Remove="Prompts\HtmlExtract.md" />
      <Content Include="Prompts\HtmlExtract.md">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..s\ApiBase\ApiBase.csproj" />
      <ProjectReference Include="..\SiteBuilderContracts\SiteBuilderContracts.csproj" />
    </ItemGroup>

    <Target Name="GenerateVersionInfo" BeforeTargets="BeforeBuild">
        <Exec Command="bash $(ProjectDir)scripts/generate-version.sh" ContinueOnError="WarnAndContinue" />
    </Target>

    <ItemGroup>
        <Content Update="version.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('version.json')" />
    </ItemGroup>
    
</Project>
